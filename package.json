    "drizzle-orm": "^1.0.0-rc.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "redis": "^6.2.0",
    "resend": "^6.18.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
